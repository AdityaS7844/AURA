# AURA Backend Environment Configuration Example
SECRET_KEY=change_this_to_a_long_random_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./wardrobe.db
UPLOAD_DIR=./uploads
FRONTEND_ORIGIN=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended Gemini models: gemini-3-flash-preview, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3-flash-preview
